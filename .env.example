# ============================================================
# Click Creators — variáveis de ambiente (copiar para .env.local)
# ============================================================
# Apenas valores PÚBLICOS podem usar o prefixo VITE_ (ficam no bundle).
#
# ⚠️  NUNCA colocar aqui a service_role key do Supabase nem qualquer
#     outro segredo. A anon key é pública por design: a segurança é
#     garantida por Row Level Security e Storage Policies.

# Supabase (área privada /memory-control)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Só em `npm run dev`: mostra a interface do painel sem sessão e sem
# dados, para rever layout/navegação. Ignorado em builds de produção.
VITE_ADMIN_UI_PREVIEW=false
